def dijkstra(graph, source):
    n = len(graph)
    dist = [float('inf')] * n
    used = [False] * n
    dist[source] = 0
    for _ in range(n):
        u = -1
        for i in range(n):
            if not used[i] and (u == -1 or dist[i] < dist[u]):
                u = i
        if u == -1 or dist[u] == float('inf'):
            break
        used[u] = True
        for v, w in enumerate(graph[u]):
            if w > 0 and dist[u] + w < dist[v]:
                dist[v] = dist[u] + w
    return dist

g = [[0, 4, 1, 0], [4, 0, 2, 1], [1, 2, 0, 5], [0, 1, 5, 0]]
print(dijkstra(g, 0))

