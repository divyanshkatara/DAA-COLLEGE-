def at_most_k(a, k):
    if k < 0:
        return 0
    counts, left, total = {}, 0, 0
    for right, x in enumerate(a):
        counts[x] = counts.get(x, 0) + 1
        while len(counts) > k:
            y = a[left]
            counts[y] -= 1
            if counts[y] == 0:
                del counts[y]
            left += 1
        total += right - left + 1
    return total

def exactly_k(a, k):
    return at_most_k(a, k) - at_most_k(a, k - 1)

print(exactly_k([1, 2, 1, 2, 3], 2))
